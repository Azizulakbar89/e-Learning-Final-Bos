rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTeacher() {
      return isAuthenticated() && request.auth.token.role == 'guru';
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users Collection (Teachers & Admins)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 2. Students Collection
    // initial_password is only visible to Admin and Teachers of the student's class
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isTeacher() || isAdmin() || isOwner(studentId)
      );
      allow create: if true; // Allows self-registration
      allow update: if isAuthenticated() && (isOwner(studentId) || isTeacher() || isAdmin());
      allow delete: if isAdmin();
    }

    // 3. Subjects, CPs, and TPs
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isAdmin();
    }

    match /curriculum_cps/{cpId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isAdmin();
    }

    match /curriculum_tps/{tpId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isAdmin();
    }

    // 4. Question Bank
    // Correct answers are protected from students during exams
    match /question_bank/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isAdmin();
    }

    // 5. Materials & Class-Isolated Forums
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isAdmin();

      // STRICT CLASS ISOLATION FOR FORUM
      match /forums/{forumId} {
        allow read, write: if isAuthenticated() && (
          isTeacher() || 
          isAdmin() ||
          request.auth.token.class_id == resource.data.class_id || 
          request.auth.token.class_id == request.resource.data.class_id
        );
      }

      // Material Assignments
      match /assignments/{assignmentId} {
        allow read: if isAuthenticated();
        allow write: if isTeacher() || isAdmin();

        match /submissions/{submissionId} {
          allow read: if isAuthenticated() && (
            isTeacher() || 
            isAdmin() || 
            request.auth.uid == resource.data.submitter_id ||
            request.auth.uid in resource.data.member_student_ids
          );
          allow create, update: if isAuthenticated();
        }
      }
    }

    // 6. Exams & Real-Time Monitoring Sessions
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isAdmin();

      match /sessions/{sessionId} {
        allow read: if isAuthenticated() && (
          isTeacher() || isAdmin() || request.auth.uid == resource.data.student_id
        );
        allow create, update: if isAuthenticated();
      }
    }

    // 7. Streaks & Chat
    match /streaks/{streakId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 8. Gamification & Grade Redeems
    match /point_transactions/{txId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /grade_redeems/{redeemId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
